# Copie para backend_v2/.env e preencha localmente. Este exemplo não é executável.
# Apenas CODELAB_V2_* é consumido; DATABASE_URL/SECRET_KEY do protótipo não são usados.
CODELAB_V2_ENVIRONMENT=development
# postgresql+asyncpg://<usuario>:<senha>@127.0.0.1:5432/codelab_v2
# Para testes: ENVIRONMENT=test e banco codelab_v2_test, sempre isolado.
CODELAB_V2_DATABASE_URL=
# Gere uma chave aleatória própria, com pelo menos 32 caracteres. Não versionar.
CODELAB_V2_SECRET_KEY=
CODELAB_V2_JUDGE0_API_URL=http://localhost:2358
CODELAB_V2_JUDGE0_API_KEY=
CODELAB_V2_JUDGE0_API_HOST=
# Limites aplicados pelo backend a cada submissão ao Judge0.
CODELAB_V2_JUDGE0_TIME_LIMIT_SECONDS=2
CODELAB_V2_JUDGE0_MEMORY_LIMIT_KB=131072
CODELAB_V2_JUDGE0_REQUEST_TIMEOUT_SECONDS=30

# Origens autorizadas do frontend (array JSON); lista vazia desabilita CORS.
CODELAB_V2_CORS_ORIGINS=[]
